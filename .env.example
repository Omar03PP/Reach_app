# Copia este archivo como .env.local y agrega tus credenciales reales.
# Supabase > Project Settings > Database > Connection string
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public"

# Para Prisma Migrate con Supabase puedes usar la URL directa si tu proyecto la requiere.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public"

# Genera un secreto con: openssl rand -base64 32
AUTH_SECRET="reemplaza-esto-con-un-secreto-seguro"
AUTH_URL="http://localhost:3000"
